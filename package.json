{
  "name": "dental-app",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --schema public > apps/web/src/lib/supabase/tipos-db.ts && prettier --write apps/web/src/lib/supabase/tipos-db.ts"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
