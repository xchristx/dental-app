# Copiar a .env.local y completar. Nunca se suben valores reales al repositorio.

# Supabase
# Local: `supabase status -o env` (API_URL y PUBLISHABLE_KEY).
# Online: panel de Supabase → Project Settings → API Keys (la clave "publishable").
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo en la demo (local o sifel.netlify.app): muestra la etiqueta
# "Demo · datos inventados" y el botón "Entrar como demo".
# En producción va en false y DEMO_EMAIL / DEMO_PASSWORD quedan vacíos.
NEXT_PUBLIC_ES_DEMO=true
DEMO_EMAIL=demo@ejemplo.test
DEMO_PASSWORD=demo-sifel

# true cuando Google está configurado como proveedor en ese proyecto de Supabase.
NEXT_PUBLIC_GOOGLE_HABILITADO=false
