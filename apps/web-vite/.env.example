# Copiar a .env.local y completar. Todas son públicas: Vite las incrusta en el
# JavaScript que descarga el navegador. Nunca poner aquí una clave secreta
# (por ejemplo, la service role de Supabase).

# Supabase
# Local: `supabase status -o env` (API_URL y PUBLISHABLE_KEY).
# Online: panel de Supabase → Project Settings → API Keys (la clave "publishable").
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo en la demo (local o sifel.netlify.app): muestra la etiqueta
# "Demo · datos inventados" y el botón "Entrar como demo". La cuenta demo es
# pública a propósito (está en supabase/seed.sql).
# En producción: VITE_ES_DEMO=false y la cuenta demo vacía.
VITE_ES_DEMO=true
VITE_DEMO_EMAIL=demo@ejemplo.test
VITE_DEMO_PASSWORD=demo-sifel

# true cuando Google está configurado como proveedor en ese proyecto de Supabase.
VITE_GOOGLE_HABILITADO=false
